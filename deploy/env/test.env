# agents in test (SUPERCONDUCTOR-20): the container's environment file
# (deploy/app.yml names it; infra copies it to the box per deploy as app.env).
# plexus-agents reads each AGENTS_* as its flag. Never a secret here: the
# server key and the WorkOS API key are the box's secret files (bin/infra
# secret.yml), named to the app by infra as AGENTS_SERVER_KEY and
# AGENTS_WORKOS_API_KEY_FILE; the box sets AGENTS_TRUSTED_PROXIES (the edge,
# 172.30.0.2/32), which WorkOS sign-in behind a proxy requires.
# The image sets AGENTS_DB=/data/agents.db (sessions: /data/agents.db.sessions),
# AGENTS_BIND=0.0.0.0 and AGENTS_PORT=4470.
AGENTS_PUBLIC_URL=https://agents-test.menger.sh
# No Claude on the box: no placement at all; runs go to hosts that dial in.
AGENTS_NO_LOCAL=1
# Sign-in (SUPERCONDUCTOR-11/25): GitHub alone, through WorkOS's STAGING client
# (the one menger's test uses). With a client named, plexus-agents builds the
# identity `workos:<client>,social=github,email=off,sso=off` itself (the same as
# AGENTS_IDENTITY would spell it, with the API key from AGENTS_WORKOS_API_KEY_FILE).
AGENTS_WORKOS_CLIENT=client_01M4GRE0HND6SKGPV780GPTYDX
# Only the hypermemetic GitHub account may sign in, for now: a GitHub numeric id.
# (Without a rule, WorkOS on a public URL refuses to start.)
AGENTS_ALLOW=github:251524973
# The operator, as WorkOS names them: admin, so they push the UI (ui.push).
AGENTS_ADMINS=oidc:workos/user_01M4GTJS2WTGNCXY1ZSXNSDE7M
# Whose signature a pushed UI bundle must carry (Ed25519 public keys, hex,
# comma-separated): the key deploy/push-ui.sh signs with. Not a secret; set it to
# `plexus-agents --print-key <that key file>` without its `key:` prefix.
# AGENTS_UI_SIGNERS=<hex>
# The UI's versions: AGENTS_UI_DB=/data/ui.db (the image sets it).
RUST_LOG=info
