# agents in test (SUPERCONDUCTOR-20): the container's environment file
# (deploy/app.yml names it; infra copies it to the box per deploy as app.env).
# deploy/entrypoint.sh turns each AGENTS_* into plexus-agents' flag. Never a
# secret here: the server key and the WorkOS key are the box's secret files
# (bin/infra secret.yml), named to the app by infra as *_FILE.
# The URL hosts dial, which their key proofs name: plexus-agents takes a
# socket URL here (an https:// one does not parse as a key audience).
AGENTS_PUBLIC_URL=wss://agents-test.menger.sh/ws
# No Claude on the box: no `local` placement. plexus-agents has no way to run
# with none yet (it defaults to `local`), so the one placement is a name no
# one holds a role on and no host is called — runs go to hosts that dial in
# (agents.on.<host>), and `agents.start placement=local` is refused.
AGENTS_PLACEMENTS=none
# No grants: no principal may start a run on the box's own placement.
AGENTS_GRANTS=
# The edge (172.30.0.2/32) is set by the box as AGENTS_TRUSTED_PROXIES; the
# entrypoint says plexus-agents has no flag for it yet.
RUST_LOG=info
