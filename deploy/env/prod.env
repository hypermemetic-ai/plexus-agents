# agents in prod (SUPERCONDUCTOR-20): declared, not deployed by this ticket.
# See test.env for what each line means.
# The URL hosts dial, which their key proofs name: plexus-agents takes a
# socket URL here (an https:// one does not parse as a key audience).
AGENTS_PUBLIC_URL=wss://agents.menger.sh/ws
# Key proofs must name the audience exactly; synapse names the port (:443).
AGENTS_KEY_AUDIENCES=wss://agents.menger.sh:443/ws
AGENTS_PLACEMENTS=none
AGENTS_GRANTS=
RUST_LOG=info
